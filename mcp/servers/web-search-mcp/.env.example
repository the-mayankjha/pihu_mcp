# Search providers. Keep secrets out of source control.
BRAVE_SEARCH_API_KEY=
# Optional Gemini API key for a future grounding provider.
GEMINI_API_KEY=

# Default provider order. HTTP provider first for speed.
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_MAX_RESULTS=8

# Fetch limits
WEB_FETCH_TIMEOUT=12
WEB_FETCH_MAX_BYTES=5000000
WEB_FETCH_MAX_CHARS=30000
WEB_MAX_REDIRECTS=5

# Browser is intentionally optional. The base implementation is HTTP-first.
WEB_BROWSER_ENABLED=false

# Cache
WEB_CACHE_TTL_SECONDS=300
