{
  "servers": {
    "pihu-file-mcp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "mcp/servers/pihu_file_mcp.py"
      ]
    },
    "pihu-system-mcp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "mcp/servers/pihu_system_mcp.py"
      ]
    },
    "web-search": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "-c",
        "import sys, os; sys.path.insert(0, os.path.abspath('mcp/servers/web-search-mcp')); from web_search_mcp.server import main; main()"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}
