{
  "servers": {
    "pihu-file-mcp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "mcp/servers/pihu_file_mcp.py"
      ]
    },
    "pihu-system-mcp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "mcp/servers/pihu_system_mcp.py"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}
