{
  "servers": {
    "pihu-file-mcp": {
      "command": "${PYTHON_EXEC}",
      "args": [
        "${SERVERS_DIR}/pihu_file_mcp.py"
      ]
    },
    "pihu-system-mcp": {
      "command": "${PYTHON_EXEC}",
      "args": [
        "${SERVERS_DIR}/pihu_system_mcp.py"
      ]
    },
    "pihu-web-search-mcp": {
      "command": "${PYTHON_EXEC}",
      "args": [
        "-c",
        "import sys, os; sys.path.insert(0, os.path.abspath('${SERVERS_DIR}/pihu-web-search-mcp')); from web_search_mcp.server import main; main()"
      ]
    },
    "pihu-project-mcp": {
      "command": "node",
      "args": [
        "${SERVERS_DIR}/pihu_project_mcp.js"
      ]
    },
    "google-workspace-mcp": {
      "command": "${PYTHON_EXEC}",
      "args": [
        "${SERVERS_DIR}/google.py"
      ]
    }
  }
}
